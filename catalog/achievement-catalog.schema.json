{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avito-recap.local/schemas/achievement-catalog.schema.json",
  "title": "Achievement catalog",
  "description": "Версионируемый каталог ачивок и декларативных правил их выдачи.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "achievements"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$",
      "description": "Версия набора правил. Меняется при изменении порогов или семантики правил."
    },
    "achievements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/achievement"
      }
    }
  },
  "$defs": {
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "description",
        "iconKey",
        "shareableByDefault",
        "sortOrder",
        "rule"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Стабильный машинный код ачивки."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Понятное человеку описание условия выдачи."
        },
        "iconKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/].*$",
          "description": "Относительный ключ объекта в S3, а не URL."
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "shareableByDefault": {
          "type": "boolean",
          "default": false
        },
        "sortOrder": {
          "type": "integer"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        }
      }
    },
    "rule": {
      "description": "Листовое условие либо логическая группа all/any.",
      "oneOf": [
        {
          "$ref": "#/$defs/condition"
        },
        {
          "$ref": "#/$defs/allRule"
        },
        {
          "$ref": "#/$defs/anyRule"
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "value"],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "description": "Ключ рассчитанной метрики, например activity.active_months."
        },
        "operator": {
          "type": "string",
          "enum": ["eq", "neq", "gt", "gte", "lt", "lte"],
          "description": "eq = равно, neq = не равно, gt = больше, gte = больше или равно, lt = меньше, lte = меньше или равно."
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": ["gt", "gte", "lt", "lte"]
              }
            },
            "required": ["operator"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "allRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "anyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    }
  }
}
